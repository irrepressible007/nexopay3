# Copy to .env (local) or set in cPanel > Setup Python App > Environment variables.
DJANGO_SETTINGS_MODULE=nexopay.settings.production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=nexopay.com.bd,www.nexopay.com.bd
CSRF_TRUSTED_ORIGINS=https://nexopay.com.bd,https://www.nexopay.com.bd
SITE_URL=https://nexopay.com.bd
ADMIN_URL=control-room/

# Let Apache serve CSS/JS and uploads directly from public_html (saves Python processes).
STATIC_ROOT=/home/nexopayc/public_html/static
MEDIA_ROOT=/home/nexopayc/public_html/media
MEDIA_URL=/media/
CACHE_DIR=/home/nexopayc/nexopay/.cache
LOG_DIR=/home/nexopayc/nexopay/logs

# cPanel MySQL/MariaDB (MySQL Databases screen)
DATABASE_URL=mysql://nexopayc_app:PASSWORD@localhost:3306/nexopayc_main

# Cloudflare R2 (optional, recommended later). Leave R2_BUCKET empty to keep uploads in MEDIA_ROOT above.
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=
# with R2: MEDIA_URL=https://media.nexopay.com.bd/

# Optional: SMTP is normally set in the admin (Site settings › Outgoing email). These are fallbacks.
EMAIL_BACKEND=apps.core.mail.SiteEmailBackend
EMAIL_HOST=mail.nexopay.com.bd
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=tickets@nexopay.com.bd
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nexopay <tickets@nexopay.com.bd>

# Optional fallbacks: merchant credentials are normally entered in the admin (Payments › Payment methods).
# Optional: separate key for encrypting admin-entered secrets (defaults to one derived from SECRET_KEY).
FIELD_ENCRYPTION_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
UPAY_MERCHANT_ID=
UPAY_MERCHANT_KEY=
UPAY_BASE_URL=
PATHAOPAY_CLIENT_ID=
PATHAOPAY_CLIENT_SECRET=
PATHAOPAY_BASE_URL=
