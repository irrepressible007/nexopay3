#: apps/accounts/allauth_texts.py:90
#, python-format
msgid ""
"You are receiving this email because you or someone else tried to signup for an\n"
"account using email address:\n"
"\n"
"%(email)s\n"
"\n"
"However, an account using that email address already exists.  In case you have\n"
"forgotten about this, please use the password forgotten procedure to recover\n"
"your account:\n"
"\n"
"%(password_reset_url)s"
msgstr ""
"আপনি অথবা অন্য কেউ এই ইমেইল ঠিকানা দিয়ে অ্যাকাউন্ট খোলার চেষ্টা করেছেন:\n"
"\n"
"%(email)s\n"
"\n"
"কিন্তু এই ইমেইলে ইতিমধ্যে একটি অ্যাকাউন্ট আছে। পাসওয়ার্ড ভুলে গিয়ে থাকলে নিচের লিংক থেকে\n"
"আপনার অ্যাকাউন্ট উদ্ধার করুন:\n"
"\n"
"%(password_reset_url)s"

#: apps/accounts/allauth_texts.py:91
msgid "Account Already Exists"
msgstr "অ্যাকাউন্ট ইতিমধ্যে আছে"

#: apps/accounts/allauth_texts.py:92
#, python-format
msgid "Hello from %(site_name)s!"
msgstr "%(site_name)s থেকে শুভেচ্ছা!"

#: apps/accounts/allauth_texts.py:93
#, python-format
msgid ""
"Thank you for using %(site_name)s!\n"
"%(site_domain)s"
msgstr ""
"%(site_name)s ব্যবহারের জন্য ধন্যবাদ!\n"
"%(site_domain)s"

#: apps/accounts/allauth_texts.py:94
msgid ""
"You are receiving this mail because the following change was made to your "
"account:"
msgstr ""
"আপনার অ্যাকাউন্টে নিচের পরিবর্তনটি করা হয়েছে বলে এই ইমেইল পাঠানো হলো:"

#: apps/accounts/allauth_texts.py:95
#, python-format
msgid ""
"If you do not recognize this change then please take proper security precautions immediately. The change to your account originates from:\n"
"\n"
"- IP address: %(ip)s\n"
"- Browser: %(user_agent)s\n"
"- Date: %(timestamp)s"
msgstr ""
"এই পরিবর্তন আপনি না করে থাকলে এখনই প্রয়োজনীয় নিরাপত্তা ব্যবস্থা নিন। পরিবর্তনটি করা হয়েছে:\n"
"\n"
"- আইপি ঠিকানা: %(ip)s\n"
"- ব্রাউজার: %(user_agent)s\n"
"- তারিখ: %(timestamp)s"

#: apps/accounts/allauth_texts.py:96
#, python-format
msgid "Your email has been changed from %(from_email)s to %(to_email)s."
msgstr "আপনার ইমেইল %(from_email)s থেকে %(to_email)s-এ পরিবর্তন করা হয়েছে।"

#: apps/accounts/allauth_texts.py:97
msgid "Email Changed"
msgstr "ইমেইল পরিবর্তিত হয়েছে"

#: apps/accounts/allauth_texts.py:98
msgid "Your email has been confirmed."
msgstr "আপনার ইমেইল নিশ্চিত হয়েছে।"

#: apps/accounts/allauth_texts.py:99
msgid "Email Confirmation"
msgstr "ইমেইল নিশ্চিতকরণ"

#: apps/accounts/allauth_texts.py:100
#, python-format
msgid ""
"You're receiving this email because user %(user_display)s has given your "
"email address to register an account on %(site_domain)s."
msgstr ""
"%(site_domain)s-এ অ্যাকাউন্ট খুলতে %(user_display)s আপনার ইমেইল ঠিকানা "
"দিয়েছেন বলে এই ইমেইল পাঠানো হলো।"

#: apps/accounts/allauth_texts.py:101
msgid ""
"Your email verification code is listed below. Please enter it in your open "
"browser window."
msgstr ""
"আপনার ইমেইল যাচাইয়ের কোড নিচে দেওয়া হলো। খোলা ব্রাউজার উইন্ডোতে কোডটি "
"লিখুন।"

#: apps/accounts/allauth_texts.py:102
#, python-format
msgid "To confirm this is correct, go to %(activate_url)s"
msgstr "এটি নিশ্চিত করতে এই লিংকে যান: %(activate_url)s"

#: apps/accounts/allauth_texts.py:103
msgid "Please Confirm Your Email Address"
msgstr "আপনার ইমেইল ঠিকানা নিশ্চিত করুন"

#: apps/accounts/allauth_texts.py:104
#, python-format
msgid "Email address %(deleted_email)s has been removed from your account."
msgstr "আপনার অ্যাকাউন্ট থেকে %(deleted_email)s ইমেইল ঠিকানাটি সরানো হয়েছে।"

#: apps/accounts/allauth_texts.py:105
msgid "Email Removed"
msgstr "ইমেইল সরানো হয়েছে"

#: apps/accounts/allauth_texts.py:106
msgid "This mail can be safely ignored if you did not initiate this action."
msgstr "আপনি এটি না করে থাকলে নিশ্চিন্তে এই ইমেইল উপেক্ষা করতে পারেন।"

#: apps/accounts/allauth_texts.py:107
msgid "Your password has been changed."
msgstr "আপনার পাসওয়ার্ড পরিবর্তন করা হয়েছে।"

#: apps/accounts/allauth_texts.py:108
msgid "Password Changed"
msgstr "পাসওয়ার্ড পরিবর্তিত"

#: apps/accounts/allauth_texts.py:109
msgid ""
"You're receiving this email because you or someone else has requested a password reset for your user account.\n"
"It can be safely ignored if you did not request a password reset. Click the link below to reset your password."
msgstr ""
