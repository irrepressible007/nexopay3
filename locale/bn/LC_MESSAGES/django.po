#: apps/accounts/allauth_texts.py:35
#, python-brace-format
msgid "Marked {email} as verified."
msgstr "{email} যাচাইকৃত হিসেবে চিহ্নিত হয়েছে।"

#: apps/accounts/allauth_texts.py:36
#, python-brace-format
msgid "Failed to mark {email} as verified."
msgstr "{email} যাচাইকৃত হিসেবে চিহ্নিত করা যায়নি।"

#: apps/accounts/allauth_texts.py:37
msgid "Mark selected email addresses as verified"
msgstr "নির্বাচিত ইমেইল ঠিকানাগুলো যাচাইকৃত হিসেবে চিহ্নিত করুন"

