#: apps/accounts/allauth_texts.py:9
msgid "This account is currently inactive."
msgstr "এই অ্যাকাউন্টটি এখন নিষ্ক্রিয়।"

#: apps/accounts/allauth_texts.py:10
msgid "You cannot remove your primary email address."
msgstr "আপনার প্রধান ইমেইল ঠিকানা সরানো যাবে না।"

#: apps/accounts/allauth_texts.py:11
msgid "This email address is already associated with this account."
msgstr "এই ইমেইল ঠিকানাটি ইতিমধ্যে এই অ্যাকাউন্টে যুক্ত আছে।"

#: apps/accounts/allauth_texts.py:12
msgid "The email address and/or password you specified are not correct."
msgstr "ইমেইল ঠিকানা বা পাসওয়ার্ড সঠিক নয়।"

#: apps/accounts/allauth_texts.py:13
msgid "The phone number and/or password you specified are not correct."
msgstr "ফোন নম্বর বা পাসওয়ার্ড সঠিক নয়।"

#: apps/accounts/allauth_texts.py:14
msgid "A user is already registered with this email address."
msgstr "এই ইমেইল ঠিকানা দিয়ে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

#: apps/accounts/allauth_texts.py:15
msgid "Please type your current password."
msgstr "আপনার বর্তমান পাসওয়ার্ড লিখুন।"

#: apps/accounts/allauth_texts.py:16
msgid "Incorrect code."
msgstr "কোডটি সঠিক নয়।"

#: apps/accounts/allauth_texts.py:17
msgid "Incorrect password."
msgstr "পাসওয়ার্ড সঠিক নয়।"

#: apps/accounts/allauth_texts.py:18
msgid "Invalid or expired key."
msgstr "কী অবৈধ অথবা মেয়াদোত্তীর্ণ।"

#: apps/accounts/allauth_texts.py:19
msgid "Invalid login."
msgstr "লগ ইন অবৈধ।"

#: apps/accounts/allauth_texts.py:20
msgid "The password reset token was invalid."
msgstr "পাসওয়ার্ড রিসেট টোকেনটি অবৈধ।"

#: apps/accounts/allauth_texts.py:21
#, python-format
msgid "You cannot add more than %d email addresses."
msgstr "%dটির বেশি ইমেইল ঠিকানা যোগ করা যাবে না।"

#: apps/accounts/allauth_texts.py:22
msgid "A user is already registered with this phone number."
msgstr "এই ফোন নম্বর দিয়ে ইতিমধ্যে একটি অ্যাকাউন্ট আছে।"

#: apps/accounts/allauth_texts.py:23
msgid "Too many failed login attempts. Try again later."
msgstr "অনেকবার ভুল লগ ইনের চেষ্টা হয়েছে। কিছুক্ষণ পরে আবার চেষ্টা করুন।"

#: apps/accounts/allauth_texts.py:24
msgid "The email address is not assigned to any user account."
msgstr "এই ইমেইল ঠিকানায় কোনো অ্যাকাউন্ট নেই।"

#: apps/accounts/allauth_texts.py:25
msgid "The phone number is not assigned to any user account."
msgstr "এই ফোন নম্বরে কোনো অ্যাকাউন্ট নেই।"

#: apps/accounts/allauth_texts.py:26
msgid "Your primary email address must be verified."
msgstr "আপনার প্রধান ইমেইল ঠিকানা যাচাই করা আবশ্যক।"

#: apps/accounts/allauth_texts.py:27
msgid "Username can not be used. Please use other username."
msgstr "এই ইউজারনেম ব্যবহার করা যাবে না। অন্য একটি দিন।"

#: apps/accounts/allauth_texts.py:28
msgid "The username and/or password you specified are not correct."
msgstr "ইউজারনেম বা পাসওয়ার্ড সঠিক নয়।"

#: apps/accounts/allauth_texts.py:29
msgid "Please select only one."
msgstr "শুধু একটি বাছুন।"

#: apps/accounts/allauth_texts.py:30
msgid "The new value must be different from the current one."
msgstr "নতুন মান বর্তমানটির থেকে আলাদা হতে হবে।"

#: apps/accounts/allauth_texts.py:31
msgid "Be patient, you are sending too many requests."
msgstr "একটু অপেক্ষা করুন, আপনি অনেক বেশি অনুরোধ পাঠাচ্ছেন।"

#: apps/accounts/allauth_texts.py:32
msgid "Use your password"
msgstr "পাসওয়ার্ড ব্যবহার করুন"

#: apps/accounts/allauth_texts.py:33
msgid "Use authenticator app or code"
